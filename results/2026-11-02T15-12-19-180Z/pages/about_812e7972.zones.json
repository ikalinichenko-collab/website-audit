    {
     "type": "paragraph",
     "text": "GoGloby is an Applied AI Engineering partner. We turn engineering into AI-native production for established software companies, making every AI dollar visible, shipping features at AI speed against your own baseline, and growing the return every month.",
     "area": "block-main",
     "index": 2
    }

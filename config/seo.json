{
  "severity": {
    "http_status": "high",
    "title_missing": "high",
    "title_too_long": "medium",
    "title_too_short": "low",
    "meta_present": "high",
    "meta_length": "low",
    "h1_count": "high",
    "title_h1_match": "low",
    "canonical": "high",
    "indexable": "high",
    "schema_required": "medium",
    "schema_recommended": "medium",
    "author": "medium",
    "dates": "medium",
    "date_mismatch": "medium",
    "broken_internal_links": "high",
    "redirecting_internal_links": "medium",
    "link_to_services": "medium",
    "alt_missing": "medium",
    "alt_empty": "low",
    "image_dimensions": "low",
    "heading_order": "low",
    "og_present": "medium",
    "og_url_canonical": "low",
    "twitter_card": "low",
    "html_lang": "low",
    "viewport": "medium",
    "jsonld_valid": "high",
    "article_fields": "medium",
    "anchors_resolve": "low",
    "faq_schema_matches_dom": "low",
    "duplicate_meta": "medium",
    "duplicate_title": "medium",
    "duplicate_h1": "medium"
  },
  "title": { "max": 60, "min": 30 },
  "meta": { "min": 120, "max": 158 },
  "title_h1": { "min_overlap": 0.5, "skip_profiles": ["home"] },
  "article_schema_fields": ["headline", "datePublished", "dateModified", "author", "image", "publisher"],
  "skip_link_patterns": ["/cdn-cgi/l/email-protection"],
  "service_path_prefix": "/services/",
  "profiles": {
    "home": { "schema_required": ["Organization", "WebSite"], "schema_recommended": [], "author": false, "dates": false, "link_to_services": true },
    "company": { "schema_required": [], "schema_recommended": ["BreadcrumbList"], "author": false, "dates": false, "link_to_services": false },
    "legal": { "schema_required": [], "schema_recommended": [], "author": false, "dates": false, "link_to_services": false },
    "service": { "schema_required": ["Service"], "schema_recommended": ["BreadcrumbList"], "author": false, "dates": false, "link_to_services": false },
    "article": { "schema_required": ["Article"], "schema_recommended": ["BreadcrumbList"], "author": true, "dates": true, "link_to_services": true },
    "case_study": { "schema_required": ["Article"], "schema_recommended": ["BreadcrumbList"], "author": false, "dates": true, "link_to_services": true },
    "podcast": { "schema_required": ["Article"], "schema_recommended": ["PodcastEpisode", "BreadcrumbList"], "author": false, "dates": true, "link_to_services": false }
  }
}

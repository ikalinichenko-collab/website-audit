    { "id": "old_layer_name", "term": "AI Intelligence Layer", "pattern": "(?<!Development )\\bAI Intelligence Layer\\b", "category": "old_terms", "rule": "Glossary §7", "note": "The product is now called the AI Development Intelligence Layer." },
    { "id": "performance_dashboard", "term": "Performance Dashboard / Center", "pattern": "\\bPerformance (?:Dashboard|Center)\\b", "category": "old_terms", "rule": "Glossary §7" },

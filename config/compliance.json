    { "id": "ai_native_production", "term": "AI-native production", "pattern": "\\bAI[- ]native production\\b", "category": "old_terms", "rule": "Glossary §7" },
    { "id": "applied_ai_company", "term": "Applied AI Company", "pattern": "\\bApplied AI Company\\b", "category": "old_terms", "rule": "Glossary §7", "note": "\"Applied AI Company\" is no longer how GoGloby describes itself." },
    { "id": "applied_ai_partner", "term": "Applied AI Engineering partner", "pattern": "\\bApplied AI Engineering partner\\b", "category": "old_terms", "rule": "Glossary §7", "note": "\"Applied AI Engineering partner\" is no longer how GoGloby describes itself." },
    { "id": "ai_staffing_alone", "term": "AI staffing (alone)", "pattern": "\\bAI staffing\\b(?! agency)", "category": "old_terms", "rule": "Glossary §7", "note": "Use \"AI engineer staffing\" or the service name, not \"AI staffing\" on its own." },

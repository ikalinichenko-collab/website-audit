    { "id": "four_x", "term": "4x (product name)", "pattern": "\\b4x (?:Applied|AI|Engineering)\\b", "category": "old_terms", "rule": "Glossary §7" },
    { "id": "safe_ai_adoption", "term": "safe AI adoption", "pattern": "\\bsafe AI adoption\\b", "category": "old_terms", "rule": "Glossary §7" },
    { "id": "ai_eng_visibility", "term": "AI Engineering Visibility", "pattern": "\\bAI Engineering Visibility\\b", "category": "old_terms", "rule": "Glossary §7" },
    { "id": "ai_cost_management", "term": "AI Cost Management", "pattern": "\\bAI Cost Management\\b", "category": "old_terms", "rule": "Glossary §7" },
    { "id": "staffing_capacity", "term": "Staffing gives capacity", "pattern": "\\bStaffing (?:gives|adds) capacity\\b", "category": "old_terms", "rule": "Glossary §7", "note": "Copy that argues against staffing: staffing is what GoGloby sells." },
    { "id": "benchmark_cta", "term": "Benchmark call to action", "pattern": "\\b(?:Start With a|Get Your|Free|Book a|Request a)\\b[^.\\n]{0,40}\\bBenchmark\\b", "category": "discontinued_offer", "rule": "Glossary §7", "note": "Benchmark is not used as the main call to action. Use \"Get vetted profiles\" for staffing and \"Start a search\" for recruiting." },
    { "id": "free_trial", "term": "free trial", "pattern": "\\bfree trial\\b", "category": "discontinued_offer", "rule": "Glossary §7", "note": "GoGloby does not offer a free trial." },

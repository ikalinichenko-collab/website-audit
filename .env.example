# Copy to .env and fill in
OPENAI_API_KEY=
# Local database: installed PostgreSQL (create role and database "audit", UTF8) or docker compose up -d (then use port 5433)
DATABASE_URL=postgres://audit:audit@127.0.0.1:5432/audit

# Sign-in with Google (leave GOOGLE_CLIENT_ID empty for local work: the server then listens on this machine only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# random string of 32+ characters, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# address people open, no trailing slash: http://127.0.0.1:8787 locally, https://your-host when deployed
PUBLIC_URL=http://127.0.0.1:8787
ALLOWED_DOMAIN=gogloby.com
